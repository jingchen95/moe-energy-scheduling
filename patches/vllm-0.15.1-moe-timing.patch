+    def _moe_timing_modules(self) -> list[nn.Module]:
+        modules = [
+            module
+            for module in self.get_model().modules()
+            if callable(getattr(module, "reset_moe_timing", None))
+            and callable(getattr(module, "dump_moe_timing", None))
+        ]
+        if not modules:
+            raise RuntimeError("no instrumented FusedMoE modules found")
+        if any(not getattr(module, "_moe_timing_enabled", False) for module in modules):
+            raise RuntimeError(
+                "MoE timing is disabled; start vLLM with VLLM_MOE_TIMING=1"
+            )
+        return modules
+
+    def reset_moe_timing(self) -> dict[str, int]:
+        """Reset rank-local FusedMoE CUDA events at an idle boundary."""
+        from vllm.distributed.parallel_state import get_ep_group
+
+        torch.cuda.synchronize()
+        modules = self._moe_timing_modules()
+        for module in modules:
+            module.reset_moe_timing()
+        ep_rank = get_ep_group().rank
+        return {"rank": ep_rank, "moe_layers": len(modules)}
+
+    def dump_moe_timing(self, output_directory: str) -> dict[str, str | int]:
+        """Resolve and dump rank-local FusedMoE CUDA-event timings."""
+        import json
+        from pathlib import Path
+
+        from vllm.distributed.parallel_state import get_ep_group
+
+        torch.cuda.synchronize()
+        modules = self._moe_timing_modules()
+        rows = []
+        for module in modules:
+            rows.extend(module.dump_moe_timing())
+
+        ep_rank = get_ep_group().rank
+        directory = Path(output_directory)
+        directory.mkdir(parents=True, exist_ok=True)
+        timing_path = directory / f"moe_timing_rank{ep_rank}.json"
+        with timing_path.open("x", encoding="utf-8") as stream:
+            json.dump({
+                "schema_version": 1,
+                "rank": ep_rank,
+                "records": rows,
+            }, stream, sort_keys=True)
+            stream.write("\n")
+        return {
+            "rank": ep_rank,
+            "moe_layers": len(modules),
+            "records": len(rows),
+            "moe_timing": str(timing_path),
+        }
+
