+    def reset_moe_timing(self) -> None:
+        """Release timing events at an explicit profile-window boundary."""
+        self._moe_timing_records.clear()
+
+    def dump_moe_timing(self) -> list[dict[str, object]]:
+        """Return rank-local CUDA-event timings after local synchronization."""
+        if not self._moe_timing_enabled:
+            return []
+        torch.cuda.synchronize()
+        rows: list[dict[str, object]] = []
+        for record in self._moe_timing_records:
+            start = record["start"]
+            end = record["end"]
+            assert isinstance(start, torch.cuda.Event)
+            assert isinstance(end, torch.cuda.Event)
+            phase_mask = record["phase_mask"]
+            decode_rows = (
+                int(phase_mask.to(dtype=torch.int32).sum().item())
+                if isinstance(phase_mask, torch.Tensor) else None
+            )
+            token_rows = int(record["token_rows"])
+            phase = (
+                "decode" if decode_rows == token_rows
+                else "prefill" if decode_rows == 0
+                else "mixed" if decode_rows is not None
+                else "unknown"
+            )
+            rows.append({
+                "layer": record["layer"],
+                "phase": phase,
+                "token_rows": token_rows,
+                "decode_rows": decode_rows,
+                "elapsed_ms": float(start.elapsed_time(end)),
+            })
+        self._moe_timing_records.clear()
+        return rows
 
