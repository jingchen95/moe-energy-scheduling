+    def phase_profile(self) -> list[tuple[torch.Tensor, torch.Tensor]]:
+        """All-reduce phase windows and map physical experts to logical IDs."""
+        if not self.phase_profile_enabled:
+            return []
+        physical: list[torch.Tensor] = []
+        for model_state in self.model_states.values():
+            assert model_state.prefill_expert_load_window is not None
+            assert model_state.decode_expert_load_window is not None
+            physical.extend([
+                model_state.prefill_expert_load_window.sum(dim=0),
+                model_state.decode_expert_load_window.sum(dim=0),
+            ])
+        reduced = self._allreduce_list(physical)
+        result: list[tuple[torch.Tensor, torch.Tensor]] = []
+        offset = 0
+        for model_state in self.model_states.values():
+            prefill_physical = reduced[offset]
+            decode_physical = reduced[offset + 1]
+            offset += 2
+            logical_prefill = torch.zeros(
+                (prefill_physical.shape[0], model_state.model.num_logical_experts),
+                dtype=torch.int64,
+                device=prefill_physical.device,
+            )
+            logical_decode = torch.zeros_like(logical_prefill)
+            logical_prefill.scatter_add_(
+                1,
+                model_state.physical_to_logical_map.long(),
+                prefill_physical.to(torch.int64),
+            )
+            logical_decode.scatter_add_(
+                1,
+                model_state.physical_to_logical_map.long(),
+                decode_physical.to(torch.int64),
+            )
+            result.append((logical_prefill, logical_decode))
+        return result
 
