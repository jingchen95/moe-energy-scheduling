+    def reset_expert_profile(self) -> dict[str, int]:
+        """Reset existing EPLB statistics at an explicit idle boundary."""
+        state = self.model_runner.eplb_state
+        if state is None:
+            raise RuntimeError("expert profiling requires --enable-eplb")
+        torch.cuda.synchronize()
+        for model_state in state.model_states.values():
+            model_state.expert_load_pass.zero_()
+            model_state.expert_load_window.zero_()
+        state.expert_load_window_step = 0
+        return {"rank": self.rank, "models": len(state.model_states)}
+
+    def dump_expert_profile(self, output_directory: str) -> dict[str, str | int]:
+        """All-reduce and dump logical counts/mapping at an explicit boundary."""
+        import json
+        from pathlib import Path
+
+        import numpy as np
+
+        from vllm.distributed.parallel_state import get_ep_group
+
+        state = self.model_runner.eplb_state
+        if state is None:
+            raise RuntimeError("expert profiling requires --enable-eplb")
+        torch.cuda.synchronize()
+        global_loads = state.rearrange(execute_shuffle=False)
+        if global_loads is None or len(global_loads) != 1:
+            raise RuntimeError("expected one profiled MoE model")
+        ep_group = get_ep_group().device_group
+        result: dict[str, str | int] = {"rank": ep_group.rank()}
+        if ep_group.rank() == 0:
+            directory = Path(output_directory)
+            directory.mkdir(parents=True, exist_ok=True)
+            counts_path = directory / "expert_counts.npz"
+            mapping_path = directory / "expert_mapping.json"
+            counts = global_loads[0].to(torch.int64).cpu().numpy()
+            np.savez_compressed(counts_path, expert_counts=counts)
+            model_state = next(iter(state.model_states.values()))
+            physical = model_state.physical_to_logical_map.cpu().tolist()
+            experts_per_rank = model_state.physical_to_logical_map.shape[1] // ep_group.size()
+            logical_to_rank = []
+            logical_to_physical_slot = []
+            for layer_physical in physical:
+                rank_row = [-1] * len(layer_physical)
+                slot_row = [-1] * len(layer_physical)
+                for physical_id, logical_id in enumerate(layer_physical):
+                    rank_row[logical_id] = physical_id // experts_per_rank
+                    slot_row[logical_id] = physical_id % experts_per_rank
+                logical_to_rank.append(rank_row)
+                logical_to_physical_slot.append(slot_row)
+            mapping_path.write_text(json.dumps({
+                "schema_version": 1,
+                "num_layers": len(physical),
+                "num_experts": len(physical[0]),
+                "num_ranks": ep_group.size(),
+                "experts_per_rank": experts_per_rank,
+                "physical_to_logical": physical,
+                "logical_to_rank": logical_to_rank,
+                "logical_to_physical_slot": logical_to_physical_slot,
+            }, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+            result.update({
+                "expert_counts": str(counts_path),
+                "expert_mapping": str(mapping_path),
+            })
+        torch.cuda.synchronize()
+        return result
+
