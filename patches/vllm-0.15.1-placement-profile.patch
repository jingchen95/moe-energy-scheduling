+def load_static_expert_placement(
+    path: str,
+    num_layers: int,
+    num_logical_experts: int,
+    num_ranks: int,
+    device: torch.device,
+) -> torch.Tensor:
+    """Load a strict logical-expert-to-rank map as physical-slot ordering."""
+    document = json.loads(Path(path).read_text(encoding="utf-8"))
+    if document.get("schema_version") != 1:
+        raise ValueError("expert placement file has unsupported schema_version")
+    if int(document.get("num_layers", -1)) != num_layers:
+        raise ValueError("expert placement num_layers does not match model")
+    if int(document.get("num_experts", -1)) != num_logical_experts:
+        raise ValueError("expert placement num_experts does not match model")
+    if int(document.get("num_ranks", -1)) != num_ranks:
+        raise ValueError("expert placement num_ranks does not match EP size")
+    if num_logical_experts % num_ranks != 0:
+        raise ValueError("logical experts must divide evenly across EP ranks")
+    experts_per_rank = num_logical_experts // num_ranks
+    if int(document.get("experts_per_rank", -1)) != experts_per_rank:
+        raise ValueError("expert placement experts_per_rank is invalid")
+    mapping = document.get("logical_to_rank")
+    if not isinstance(mapping, list) or len(mapping) != num_layers:
+        raise ValueError("expert placement logical_to_rank has invalid layer count")
+    physical_to_logical: list[list[int]] = []
+    for layer, row in enumerate(mapping):
+        if not isinstance(row, list) or len(row) != num_logical_experts:
+            raise ValueError(f"expert placement layer {layer} has invalid expert count")
+        if any(type(rank) is not int or rank < 0 or rank >= num_ranks for rank in row):
+            raise ValueError(f"expert placement layer {layer} contains an invalid EP rank")
+        ordered: list[int] = []
+        for rank in range(num_ranks):
+            experts = [expert for expert, assigned_rank in enumerate(row)
+                       if assigned_rank == rank]
+            if len(experts) != experts_per_rank:
+                raise ValueError(
+                    f"expert placement layer {layer}, rank {rank}: expected "
+                    f"{experts_per_rank} experts, found {len(experts)}"
+                )
+            ordered.extend(experts)
+        physical_to_logical.append(ordered)
+    return torch.tensor(physical_to_logical, dtype=torch.long, device=device)
+
