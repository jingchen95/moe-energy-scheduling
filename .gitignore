# Per-run artifacts.  Every run uses a new directory below results/raw/.
results/raw/*
!results/raw/.gitkeep
logs/
slurm-*.out
slurm-*.err

# Downloaded models and caches.
data/datasets/
data/models/
models/
.cache/
*.safetensors
*.bin

# Python and editor state.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.deps/
.env
.DS_Store
.idea/
.vscode/

# Apptainer runtime artifacts are large single-file binaries. Keep recipes and
# documentation, but never add images or writable overlays to Git.
containers/*.sif
containers/*.img
containers/*.ext3
